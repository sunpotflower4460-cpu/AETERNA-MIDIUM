{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "dist",
    "rootDir": "src"
  },
  "include": [
    "src/bridge/**/*.ts",
    "src/signal/**/*.ts",
    "src/types/**/*.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
